## MongoDB Atlas (Vector Search)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB="yolo_assistant"
MONGODB_COLLECTION="code_chunks"
MONGODB_VECTOR_INDEX="default"
MONGODB_EMBEDDING_PATH="embedding"

## OpenRouter (LLM)
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="deepseek/deepseek-r1:free"

## Embeddings / chunking
EMBED_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHUNK_TOKEN_TARGET=500
CHUNK_OVERLAP_TOKENS=50

## Path to cloned Ultralytics repo
ULTRALYTICS_PATH="/absolute/path/to/ultralytics"
